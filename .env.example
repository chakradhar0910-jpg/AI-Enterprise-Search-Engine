# Application Configuration
SECRET_KEY=enterprise-search-super-secret-key-change-in-production
FLASK_ENV=development
DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///enterprise_search.db

# Storage Directories (Relative to workspace root or absolute)
UPLOAD_FOLDER=data/uploads
PROCESSED_FOLDER=data/processed
VECTOR_STORE_DIR=data/vector_store

# AI & NLP Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=5

# LLM Configuration
# Supported providers: groq, openai, gemini, ollama, mock (extractive grounded synthesis)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant

# API Keys (Optional depending on provider chosen)
# If no API key is provided, the system operates in Extractive Grounded RAG mode with full transparency.
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
